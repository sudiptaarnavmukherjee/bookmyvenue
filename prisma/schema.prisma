datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  USER
  VENUE_OWNER
  CATERING_OWNER
  ADMIN
}

enum PriceMode {
  EXACT
  ESTIMATED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum BookingType {
  VENUE
  CATERING
}

enum PackageTier {
  SILVER
  GOLD
  DIAMOND
  PLATINUM
}

enum MenuVariant {
  NON_VEG   // Full Bengali non-veg (default)
  VEG       // No fish/meat
  JAIN      // No onion/garlic (for Shradh, Jain guests)
}

// Master library of menu categories (e.g. "Starters", "Fish Dishes")
model MenuCategory {
  id        String  @id @default(cuid())
  name      String  @unique
  sortOrder Int     @default(0)
  icon      String? // emoji or icon name

  items MenuItemTemplate[]

  @@index([sortOrder])
}

// Master library of Bengali dishes
model MenuItemTemplate {
  id          String  @id @default(cuid())
  name        String
  isVeg       Boolean @default(true)
  isPopular   Boolean @default(false)
  description String?
  sortOrder   Int     @default(0)

  categoryId String
  category   MenuCategory @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([isVeg])
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  phone         String?
  phoneVerified DateTime?

  // Phone OTP (stored temporarily during verification)
  phoneOtpCode   String?   // 6-digit OTP
  phoneOtpExpiry DateTime? // expires 10 min after send

  role          UserRole  @default(USER)
  password      String
  image         String?

  // Status
  isActive Boolean @default(true)
  isBanned Boolean @default(false)
  banReason String?

  // KYC (for owners)
  aadhaarNumber String? @unique
  panNumber     String? @unique
  gstNumber     String?
  kycVerified   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  bookings     Booking[]
  reviews      Review[]
  venues       Venue[]
  caterings    Caterer[]
  wishlists    Wishlist[]
  blockedDates BlockedDate[] @relation("BlockedDates")
  payouts      Payout[]      @relation("OwnerPayouts")
  auditLogs    AuditLog[]    @relation("AuditLogs")
  accounts     Account[]
  sessions     Session[]
  inquiries    UserInquiry[] @relation("UserInquiries")
  metrics      OwnerMetrics? @relation("OwnerMetrics")
  retentionCampaigns RetentionCampaign[] @relation("RetentionCampaigns")
  pushSubscriptions PushSubscription[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Venue {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String  @db.Text
  city        String
  area        String?
  address     String  @db.Text
  pincode     String
  latitude    Float?
  longitude   Float?

  // Pricing
  priceMode         PriceMode
  exactPrice        Float?
  estimatedMinPrice Float?
  estimatedMaxPrice Float?

  // Event-Type Pricing (USP: 3 visible tiers everywhere)
  marriagePrice     Float?    // Wedding / Biye / Engagement ceremonies
  birthdayPrice     Float?    // Birthday, Anniversary, Baby Shower
  otherEventPrice   Float?    // Shradh, Annaprasan, Corporate, others

  // Fishbowl Model - Prime/Non-Prime Pricing
  primeDayPrice     Float?    // Wedding season / auspicious days price
  nonPrimeDayPrice  Float?    // Off-season / regular days price
  primeDays         String?   // Comma-separated: "Saturday,Sunday,Auspicious"
  
  // Fishbowl Model - Admin Control
  isAdminListed     Boolean   @default(true)   // true = fishbowl (admin added), false = owner added
  taggedToOwnerId   String?   // When verified, this owner gets control
  contactNumber     String?   // Direct contact for fishbowl listings
  contactName       String?   // Contact person name
  bookingEnabled    Boolean   @default(false)  // Only true for verified + tagged owners

  // Verification & Status
  isVerified        Boolean   @default(false)
  isActive          Boolean   @default(true)
  verificationNotes String?
  verifiedAt        DateTime?

  // Capacity
  minGuests Int
  maxGuests Int

  // Media
  images     String // Comma-separated URLs
  coverImage String
  videos     String // Comma-separated URLs

  // Amenities
  amenities String // Comma-separated list
  venueType String?

  // Offline bookings (for Calendar OS)
  offlineBookings String // Comma-separated ISO dates

  // Maps & Location
  googleMapsUrl String? // Google Maps share link (e.g. https://maps.app.goo.gl/xxx)

  // Analytics
  viewCount    Int @default(0)
  inquiryCount Int @default(0)
  weeklyViews  Int @default(0)

  // SEO
  metaTitle       String?
  metaDescription String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now())
  deletedAt DateTime?

  // Relations
  ownerId        String
  owner          User            @relation(fields: [ownerId], references: [id])
  bookings       Booking[]
  reviews        Review[]
  wishlist       Wishlist[]
  blockedDates   BlockedDate[]
  viewAnalytics  ViewAnalytics[]
  inquiries      UserInquiry[]   @relation("VenueInquiries")

  @@index([city])
  @@index([area])
  @@index([slug])
  @@index([isVerified])
  @@index([isAdminListed])
}

model Caterer {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String
  city        String
  area        String?
  address     String
  phone       String
  latitude    Float?
  longitude   Float?

  // Pricing
  minPlatePrice Float
  rating        Float @default(0)
  totalReviews  Int   @default(0)

  // Fishbowl Model - Tier Pricing (Admin sets these)
  silverPrice    Float?    // Silver tier price per plate
  goldPrice      Float?    // Gold tier price per plate
  platinumPrice  Float?    // Platinum tier price per plate
  
  // Fishbowl Model - Admin Control
  isAdminListed    Boolean   @default(true)   // true = fishbowl (admin added)
  taggedToOwnerId  String?   // When verified, this owner gets control
  contactNumber    String?   // Direct contact for fishbowl listings
  contactName      String?   // Contact person name
  bookingEnabled   Boolean   @default(false)  // Only true for verified + tagged owners

  // Features
  isPureVeg      Boolean  @default(false)
  isMultiCuisine Boolean  @default(true)
  cuisines       String // Comma-separated cuisines
  minGuests      Int?

  // Media
  images     String // Comma-separated URLs
  coverImage String

  // Status
  isActive   Boolean @default(true)
  isVerified Boolean @default(false)

  // Verification Flow
  verificationRequestedAt DateTime? // Set when owner clicks "Request Verification"
  verificationNotes       String?   // Admin notes when approving / rejecting

  // Maps & Location
  googleMapsUrl String? // Google Maps share link

  // Analytics
  viewCount    Int @default(0)
  inquiryCount Int @default(0)
  weeklyViews  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  // Relations
  ownerId        String
  owner          User            @relation(fields: [ownerId], references: [id])
  packages       MenuPackage[]
  bookings       Booking[]
  reviews        Review[]
  wishlist       Wishlist[]
  blockedDates   BlockedDate[]
  viewAnalytics  ViewAnalytics[]
  inquiries      UserInquiry[]   @relation("CatererInquiries")

  @@index([city])
  @@index([area])
  @@index([slug])
  @@index([isAdminListed])
}

model MenuPackage {
  id            String      @id @default(cuid())
  tier          PackageTier
  variant       MenuVariant @default(NON_VEG)
  name          String
  description   String?
  pricePerPlate Float
  itemCount     Int
  items         Json // Legacy flat list + structured: [{category, items[]}]
  isTemplate    Boolean @default(false) // true = global template, can be cloned

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  // Relations
  catererId String?  // null when isTemplate=true (global template)
  caterer   Caterer? @relation(fields: [catererId], references: [id])

  @@index([catererId])
  @@index([tier])
  @@index([isTemplate])
}

model Booking {
  id            String        @id @default(cuid())
  bookingNumber String        @unique
  type          BookingType
  status        BookingStatus @default(PENDING)

  // Event Details
  eventDate  DateTime
  eventType  String?
  guestCount Int?

  // Venue Booking
  venueId String?
  venue   Venue?  @relation(fields: [venueId], references: [id])

  // Catering Booking
  catererId       String?
  caterer         Caterer?     @relation(fields: [catererId], references: [id])
  selectedPackage PackageTier?

  // Pricing
  baseAmount    Float?
  taxAmount     Float?
  totalAmount   Float?
  advanceAmount Float?
  balanceAmount Float?

  // Payment
  isPaid        Boolean @default(false)
  paymentMethod String?
  paymentId     String?

  // Contact
  customerName    String
  customerEmail   String
  customerPhone   String
  specialRequests String?

  // Timeline
  confirmedAt        DateTime?
  cancelledAt        DateTime?
  completedAt        DateTime?
  cancellationReason String?

  // Retention Email Tracking
  reminderEmailSentAt DateTime?   // Pre-event reminder (7 days, 3 days, or 1 day before)
  feedbackEmailSentAt DateTime?   // Post-event feedback request (1-2 days after event)

  // Notes
  ownerNotes String?
  adminNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  // Relations
  userId   String
  user     User      @relation(fields: [userId], references: [id])
  payments Payment[]
  review   Review?
  cancellationRequest CancellationRequest?
  retentionCampaigns RetentionCampaign[] @relation("BookingRetention")

  @@index([eventDate])
  @@index([status])
  @@index([userId])
  @@index([bookingNumber])
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentType {
  ADVANCE
  BALANCE
  FULL
  REFUND
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Payment {
  id       String        @id @default(cuid())
  amount   Float
  currency String        @default("INR")
  status   PaymentStatus @default(PENDING)
  type     PaymentType   @default(ADVANCE)

  // Gateway details (Razorpay)
  razorpayOrderId   String? @unique
  razorpayPaymentId String? @unique
  razorpaySignature String?

  // Receipt
  receiptNumber String? @unique
  receiptUrl    String?

  // Metadata
  method        String?  // card, upi, netbanking, wallet
  bank          String?  // For netbanking
  wallet        String?  // For wallet payments
  vpa           String?  // For UPI
  cardLast4     String?  // Last 4 digits of card
  cardNetwork   String?  // Visa, Mastercard, etc.

  // Timestamps
  paidAt        DateTime?
  failedAt      DateTime?
  refundedAt    DateTime?
  failureReason String?

  // Refund details
  refundId      String?
  refundAmount  Float?
  refundReason  String?

  // Commission & Payout tracking
  platformFee     Float?   // Platform commission amount
  ownerAmount     Float?   // Amount to be paid to owner
  isOwnerPaid     Boolean  @default(false)
  ownerPaidAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  // Relations
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@index([razorpayOrderId])
  @@index([status])
  @@index([createdAt])
}

// Owner Payout tracking
model Payout {
  id           String       @id @default(cuid())
  amount       Float
  currency     String       @default("INR")
  status       PayoutStatus @default(PENDING)

  // Bank details snapshot (at time of payout)
  bankAccountNumber String?
  bankIfscCode      String?
  bankAccountName   String?
  bankName          String?

  // UPI details
  upiId String?

  // Razorpay Payout
  razorpayPayoutId   String? @unique
  razorpayFundAcctId String?

  // Processing details
  processedAt     DateTime?
  failedAt        DateTime?
  failureReason   String?
  transferMode    String?  // NEFT, IMPS, UPI

  // Period covered
  periodStart DateTime
  periodEnd   DateTime
  
  // Summary
  totalBookings    Int     @default(0)
  totalGross       Float   @default(0)
  platformFee      Float   @default(0)
  taxDeducted      Float?  @default(0)  // TDS if applicable

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  // Relations
  ownerId String
  owner   User   @relation("OwnerPayouts", fields: [ownerId], references: [id])

  @@index([ownerId])
  @@index([status])
  @@index([createdAt])
}

// Email notification log
model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  template  String   // Template name used
  status    String   @default("PENDING") // PENDING, SENT, FAILED
  
  // Email service response
  messageId   String?
  provider    String?  // resend, sendgrid, etc.
  error       String?
  
  // Metadata
  metadata    Json?    // Any additional data
  
  sentAt      DateTime?
  createdAt   DateTime @default(now())

  // Optional relations
  bookingId String?
  userId    String?

  @@index([to])
  @@index([template])
  @@index([createdAt])
}

model Review {
  id      String  @id @default(cuid())
  rating  Int     // 1-5 stars
  comment String? @db.Text
  images  String? // Comma-separated image URLs

  // Venue Review
  venueId String?
  venue   Venue?  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  // Caterer Review
  catererId String?
  caterer   Caterer? @relation(fields: [catererId], references: [id], onDelete: Cascade)

  // Booking verification - must have completed booking to review
  bookingId String? @unique
  booking   Booking? @relation(fields: [bookingId], references: [id])

  // Owner response
  ownerResponse   String?   @db.Text
  ownerRespondedAt DateTime?

  // Moderation
  isVerified Boolean @default(false) // Verified purchase
  isApproved Boolean @default(true)  // Admin moderation
  isFlagged  Boolean @default(false) // Flagged for review

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([venueId])
  @@index([catererId])
  @@index([rating])
  @@index([isApproved])
}

model Wishlist {
  id String @id @default(cuid())

  // Venue Wishlist
  venueId String?
  venue   Venue?  @relation(fields: [venueId], references: [id])

  // Caterer Wishlist
  catererId String?
  caterer   Caterer? @relation(fields: [catererId], references: [id])

  createdAt DateTime @default(now())

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, venueId])
  @@unique([userId, catererId])
}

model BlockedDate {
  id              String   @id @default(cuid())
  date            DateTime
  reason          String?
  isOnlineBooking Boolean  @default(false) // true = booked through platform, false = owner blocked
  bookingId       String? // Reference to booking if online

  // Venue or Caterer (one must be set)
  venueId String?
  venue   Venue?  @relation(fields: [venueId], references: [id])

  catererId String?
  caterer   Caterer? @relation(fields: [catererId], references: [id])

  // Owner who blocked (for manual blocks)
  blockedBy String?
  owner     User?   @relation("BlockedDates", fields: [blockedBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@unique([venueId, date])
  @@unique([catererId, date])
  @@index([venueId, date])
  @@index([catererId, date])
}

// Area model for intelligent location-based sorting
model Area {
  id           String  @id @default(cuid())
  name         String  @unique
  city         String
  state        String  @default("West Bengal")
  pincode      String?
  latitude     Float?
  longitude    Float?
  isPopular    Boolean @default(false)
  priority     Int     @default(0)  // Higher priority = shown first
  
  // Analytics
  venueCount   Int     @default(0)
  catererCount Int     @default(0)
  totalViews   Int     @default(0)
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())

  @@index([city])
  @@index([isPopular])
}

// View Analytics for tracking popularity
model ViewAnalytics {
  id          String   @id @default(cuid())
  venueId     String?
  venue       Venue?   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  catererId   String?
  caterer     Caterer? @relation(fields: [catererId], references: [id], onDelete: Cascade)
  area        String?
  city        String?
  date        DateTime @default(now())
  viewCount   Int      @default(1)
  uniqueViews Int      @default(1)
  
  @@index([venueId, date])
  @@index([catererId, date])
  @@index([area, date])
}

// Audit Log for compliance and tracking
model AuditLog {
  id         String   @id @default(cuid())
  action     String   // PAYOUT_APPROVED, USER_BANNED, VENUE_VERIFIED, etc.
  entityType String   // PAYOUT, USER, VENUE, CATERER, BOOKING, REVIEW
  entityId   String   // ID of the entity
  userId     String   // Admin/user who performed the action
  
  // Change details
  details    Json?    // Action-specific data
  previousValue Json? // State before change
  newValue   Json?    // State after change
  
  // Request context
  ipAddress  String?
  userAgent  String?
  
  createdAt  DateTime @default(now())
  
  // Relations
  user       User     @relation("AuditLogs", fields: [userId], references: [id])

  @@index([action])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

// System Configuration
model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  type      String   @default("string") // string, number, boolean, json
  category  String   @default("general") // general, payment, email, etc.
  description String?
  
  updatedBy String?
  updatedAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([category])
}

// ==================== PHASE 8 MODELS ====================

// Promotional Codes / Discount Coupons
model PromoCode {
  id          String    @id @default(cuid())
  code        String    @unique
  description String?
  
  // Discount Configuration
  discountType   String    // PERCENTAGE, FLAT
  discountValue  Float     // Percentage or flat amount
  maxDiscount    Float?    // Maximum discount for percentage type
  minOrderValue  Float?    // Minimum order value to apply
  
  // Usage Limits
  usageLimit     Int?      // Total times code can be used (null = unlimited)
  perUserLimit   Int       @default(1)  // Times per user
  usedCount      Int       @default(0)
  
  // Validity
  startDate      DateTime  @default(now())
  expiryDate     DateTime?
  isActive       Boolean   @default(true)
  
  // Targeting
  applicableTo   String    @default("ALL")  // ALL, VENUE, CATERING
  applicableIds  String?   // Specific venue/caterer IDs (comma-separated)
  forNewUsers    Boolean   @default(false)  // Only for first-time users
  
  // Creator
  createdBy      String?   // Admin who created
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  // Relations
  usages         PromoCodeUsage[]

  @@index([code])
  @@index([isActive])
  @@index([expiryDate])
}

// Track promo code usage
model PromoCodeUsage {
  id          String    @id @default(cuid())
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id])
  
  userId      String
  bookingId   String?
  
  discountApplied Float
  orderAmount     Float
  
  usedAt      DateTime  @default(now())

  @@unique([promoCodeId, bookingId])
  @@index([userId])
  @@index([promoCodeId])
}

// ==================== PHASE 2: ANALYTICS & ENGAGEMENT ====================

// Track user interactions for analytics and insights
model AnalyticsEvent {
  id          String    @id @default(cuid())
  
  // Event details
  eventType   String    // VIEW, SEARCH, INQUIRY, BOOKING, SHARE, WISHLIST_ADD, COMPARE, FILTER
  entityType  String    // VENUE, CATERER, BOOKING, SEARCH
  entityId    String    // ID of the venue/caterer/booking being tracked
  
  // User context
  userId      String?   // Anonymous if not logged in
  
  // Event metadata
  metadata    Json?     // Additional context (search params, filter values, etc.)
  timestamp   DateTime  @default(now())
  createdAt   DateTime  @default(now())
  
  @@index([eventType])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([timestamp])
  @@index([createdAt])
}

// Track user inquiries and follow-ups
model UserInquiry {
  id          String    @id @default(cuid())
  
  // Inquiry details
  userId      String?
  user        User?     @relation("UserInquiries", fields: [userId], references: [id])
  
  venueId     String?
  venue       Venue?    @relation("VenueInquiries", fields: [venueId], references: [id])
  
  catererId   String?
  caterer     Caterer?  @relation("CatererInquiries", fields: [catererId], references: [id])
  
  // Inquiry content
  message     String
  eventType   String    // WEDDING, BIRTHDAY, CORPORATE, etc.
  eventDate   DateTime?
  guestCount  Int?
  budget      Float?
  
  // Status tracking
  status      String    @default("PENDING") // PENDING, CONTACTED, INTERESTED, BOOKED, REJECTED
  
  // Contact details
  phoneNumber String?
  email       String?
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([userId])
  @@index([venueId])
  @@index([catererId])
  @@index([status])
  @@index([createdAt])
}

// Owner engagement metrics (denormalized for fast dashboards)
model OwnerMetrics {
  id          String    @id @default(cuid())
  
  ownerId     String    @unique
  owner       User      @relation("OwnerMetrics", fields: [ownerId], references: [id])
  
  // Aggregated metrics
  totalViews  Int       @default(0)
  totalInquiries Int    @default(0)
  totalBookings Int     @default(0)
  totalRevenue Float    @default(0)
  
  // Time-based metrics
  viewsThisMonth Int    @default(0)
  inquiriesThisMonth Int @default(0)
  bookingsThisMonth Int  @default(0)
  
  // Engagement rates
  conversionRate Float? // inquiries / views
  bookingRate    Float? // bookings / inquiries
  
  // Last activity
  lastViewAt     DateTime?
  lastInquiryAt  DateTime?
  lastBookingAt  DateTime?
  
  updatedAt      DateTime @updatedAt
  
  @@index([ownerId])
}


// Invoice/Receipt Storage
model Invoice {
  id            String    @id @default(cuid())
  invoiceNumber String    @unique
  
  // Type
  type          String    @default("RECEIPT")  // RECEIPT, INVOICE, PROFORMA
  
  // Booking Reference
  bookingId     String
  paymentId     String?
  
  // Amounts
  subtotal      Float
  discount      Float     @default(0)
  taxAmount     Float     @default(0)
  totalAmount   Float
  
  // Tax Details (for GST compliance)
  cgst          Float?
  sgst          Float?
  igst          Float?
  gstNumber     String?   // Customer GST (for B2B)
  
  // PDF Storage
  pdfUrl        String?
  generatedAt   DateTime?
  
  // Customer Details Snapshot
  customerName  String
  customerEmail String
  customerPhone String
  customerAddress String?
  
  // Business Details Snapshot
  businessName  String
  businessAddress String
  businessGst   String?
  
  createdAt     DateTime  @default(now())
  
  @@index([bookingId])
  @@index([invoiceNumber])
}

// SMS Log for tracking
model SmsLog {
  id          String    @id @default(cuid())
  to          String    // Phone number
  message     String    @db.Text
  template    String    // Template ID
  
  // Provider details
  provider    String    @default("twilio")  // twilio, msg91, etc.
  messageId   String?   // Provider message ID
  status      String    @default("PENDING")  // PENDING, SENT, DELIVERED, FAILED
  
  // Error tracking
  error       String?
  
  // Cost tracking
  cost        Float?
  
  // Relations
  bookingId   String?
  userId      String?
  
  sentAt      DateTime?
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([to])
  @@index([status])
  @@index([createdAt])
}

// Cancellation Request
model CancellationRequest {
  id          String    @id @default(cuid())
  bookingId   String    @unique
  booking     Booking   @relation(fields: [bookingId], references: [id])
  
  // Request Details
  requestedBy String    // USER, OWNER, ADMIN
  reason      String    @db.Text
  
  // Status
  status      String    @default("PENDING")  // PENDING, APPROVED, REJECTED, PROCESSED
  approvedAt  DateTime?
  
  // Refund Details
  refundAmount      Float?
  refundPercentage  Float?    // Based on cancellation policy
  platformFeeRetained Float?
  
  // Processing
  processedBy   String?   // Admin who processed
  processedAt   DateTime?
  processNotes  String?
  
  // Refund Tracking
  refundStatus  String?   // PENDING, PROCESSING, COMPLETED, FAILED
  refundId      String?   // Razorpay refund ID
  refundedAt    DateTime?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([bookingId])
}

// Email Templates
model EmailTemplate {
  id          String    @id @default(cuid())
  name        String    @unique  // booking_confirmation, payment_receipt, etc.
  subject     String
  body        String    @db.Text  // HTML template with {{variables}}
  
  // Metadata
  description String?
  category    String    @default("transactional")  // transactional, marketing, reminder
  
  // Status
  isActive    Boolean   @default(true)
  
  // Version control
  version     Int       @default(1)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([name])
  @@index([category])
}

// ==================== PHASE 3: RETENTION AUTOMATION ====================

// Track retention emails sent to users (reminders, feedback requests, re-engagement)
model RetentionCampaign {
  id            String    @id @default(cuid())
  
  // Campaign details
  userId        String
  user          User      @relation("RetentionCampaigns", fields: [userId], references: [id])
  
  // Related to booking if applicable
  bookingId     String?
  booking       Booking?  @relation("BookingRetention", fields: [bookingId], references: [id])
  
  // Campaign type
  campaignType  String    // EVENT_REMINDER, POST_EVENT_FEEDBACK, RE_ENGAGEMENT, BIRTHDAY_OFFER
  
  // Email tracking
  emailSentAt   DateTime?
  emailOpenedAt DateTime?
  emailClickedAt DateTime?
  
  // Status
  status        String    @default("PENDING")  // PENDING, SENT, OPENED, CLICKED, BOUNCED, FAILED
  emailId       String?   // External email provider ID
  
  // Campaign metadata
  metadata      Json?     // triggeredOn, eventDate, daysInactive, etc.
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([userId])
  @@index([bookingId])
  @@index([campaignType])
  @@index([status])
  @@index([emailSentAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}
