# Database
# Get your database URL from: https://supabase.com (free tier)
# Or use PlanetScale: https://planetscale.com
# Or use Neon: https://neon.tech
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# NextAuth.js
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl"
NEXTAUTH_URL="http://localhost:3000"

# Razorpay (Get from: https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_secret_here"

# Email Service (Resend - free 100 emails/day)
# Get from: https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxx"
EMAIL_FROM="noreply@yourdomain.com"

# File Upload (Cloudinary - free 25GB)
# Get from: https://cloudinary.com/console
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# SMS (Optional - MSG91 for India)
MSG91_AUTH_KEY="your_msg91_auth_key"
MSG91_SENDER_ID="SHUBBK"

# Analytics (Optional)
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Monitoring (Optional - Sentry)
NEXT_PUBLIC_SENTRY_DSN="https://xxxxx@xxxxx.ingest.sentry.io/xxxxx"
